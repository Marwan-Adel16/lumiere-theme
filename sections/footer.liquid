{% comment %} sections/footer.liquid {% endcomment %}

<style>
  .footer {
    background-color: rgb(var(--color-base-background));
    color: rgb(var(--color-base-text));
    border-top: 0.1rem solid rgba(var(--color-base-text), 0.08);
    padding: 5rem 0 3rem;
  }

  .footer__blocks-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    margin-bottom: 5rem;
  }

  @media screen and (min-width: 768px) {
    .footer__blocks-wrapper {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .footer__blocks-wrapper {
      grid-template-columns: repeat(4, 1fr);
      gap: 3rem;
    }
  }

  .footer-block__heading {
    font-size: 1.6rem;
    font-weight: bold;
    margin-bottom: 2rem;
    color: rgb(var(--color-base-heading));
  }

  .footer-block__text {
    font-size: 1.4rem;
    line-height: 1.6;
    color: rgba(var(--color-base-text), 0.8);
  }

  .footer-block__logo {
    display: block;
    max-width: 100%;
    height: auto;
    margin-bottom: 2rem;
  }

  .footer-block__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-block__list-item {
    margin-bottom: 1.2rem;
  }

  .footer-block__list-item:last-child {
    margin-bottom: 0;
  }

  .footer-block__link {
    color: rgba(var(--color-base-text), 0.8);
    text-decoration: none;
    font-size: 1.4rem;
    transition: color 0.2s ease, padding-left 0.2s ease;
    display: inline-block;
  }

  .footer-block__link:hover {
    color: rgb(var(--color-base-accent));
    padding-left: 0.5rem;
  }

  /* Newsletter */
  .footer__newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__newsletter-input-group {
    display: flex;
    position: relative;
    width: 100%;
  }

  .footer__newsletter-input {
    width: 100%;
    padding: 1.2rem 4.5rem 1.2rem 1.5rem;
    border: 0.1rem solid rgba(var(--color-base-text), 0.2);
    border-radius: 0.4rem;
    background-color: transparent;
    color: rgb(var(--color-base-text));
    font-size: 1.4rem;
    transition: border-color 0.2s ease;
  }

  .footer__newsletter-input:focus {
    outline: none;
    border-color: rgb(var(--color-base-accent));
  }

  .footer__newsletter-button {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    background: transparent;
    border: none;
    color: rgb(var(--color-base-text));
    padding: 0 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }

  .footer__newsletter-button:hover {
    color: rgb(var(--color-base-accent));
  }

  .footer__newsletter-button svg {
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .form-status {
    margin-top: 1rem;
    font-size: 1.3rem;
  }

  .form-status--success {
    color: #28a745;
  }

  .form-status--error {
    color: #dc3545;
  }

  /* Bottom Bar */
  .footer__content-bottom {
    border-top: 0.1rem solid rgba(var(--color-base-text), 0.08);
    padding-top: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  @media screen and (min-width: 990px) {
    .footer__content-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer__social-list {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__social-link {
    color: rgba(var(--color-base-text), 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    background-color: rgba(var(--color-base-text), 0.04);
    transition: all 0.2s ease;
  }

  .footer__social-link:hover {
    color: rgb(var(--color-base-background));
    background-color: rgb(var(--color-base-accent));
    transform: translateY(-0.2rem);
  }

  .footer__social-link svg {
    width: 1.8rem;
    height: 1.8rem;
    fill: currentColor;
  }

  .footer__copyright {
    font-size: 1.3rem;
    color: rgba(var(--color-base-text), 0.7);
    text-align: center;
  }

  .footer__copyright-link {
    color: inherit;
    text-decoration: none;
  }

  .footer__copyright-link:hover {
    text-decoration: underline;
  }

  .footer__payment-methods {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__payment-icon svg {
    width: 3.8rem;
    height: 2.4rem;
  }
</style>

<footer class="footer" role="contentinfo">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__blocks-wrapper">
        {%- for block in section.blocks -%}
          <div class="footer-block" {{ block.shopify_attributes }}>
            
            {%- if block.type == 'info' -%}
              {%- if block.settings.logo != blank -%}
                {%- assign logo_size = block.settings.logo_width | append: 'x' -%}
                <img
                  srcset="{{ block.settings.logo | image_url: width: block.settings.logo_width }}, {{ block.settings.logo | image_url: width: block.settings.logo_width, scale: 2 }} 2x"
                  src="{{ block.settings.logo | image_url: width: block.settings.logo_width }}"
                  alt="{{ block.settings.logo.alt | default: shop.name | escape }}"
                  loading="lazy"
                  class="footer-block__logo"
                  width="{{ block.settings.logo.width }}"
                  height="{{ block.settings.logo.height }}"
                  style="max-width: {{ block.settings.logo_width }}px;"
                >
              {%- elsif block.settings.heading != blank -%}
                <h2 class="footer-block__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="footer-block__text">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

            {%- elsif block.type == 'link_list' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="footer-block__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}

              {%- if block.settings.menu != blank -%}
                <ul class="footer-block__list">
                  {%- for link in block.settings.menu.links -%}
                    <li class="footer-block__list-item">
                      <a href="{{ link.url }}" class="footer-block__link">
                        {{ link.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

            {%- elsif block.type == 'newsletter' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="footer-block__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="footer-block__text" style="margin-bottom: 2rem;">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

              {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="footer__newsletter-input-group">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="footer__newsletter-input"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="ContactFooter-error"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="ContactFooter-success"
                    {% endif %}
                    placeholder="Email address"
                    required
                  >
                  <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">Email address</label>
                  <button type="submit" class="footer__newsletter-button" name="commit" aria-label="Subscribe">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>

                {%- if form.errors -%}
                  <div class="form-status form-status--error" id="ContactFooter-error" tabindex="-1" autofocus>
                    {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                  </div>
                {%- endif -%}
                
                {%- if form.posted_successfully? -%}
                  <div class="form-status form-status--success" id="ContactFooter-success" tabindex="-1" autofocus>
                    Thanks for subscribing!
                  </div>
                {%- endif -%}
              {%- endform -%}
            {%- endif -%}

          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__content-bottom">
      
      {%- if section.settings.show_social -%}
        <div class="footer__socials">
          <ul class="footer__social-list" role="list">
            {%- if section.settings.social_instagram_link != blank -%}
              <li>
                <a href="{{ section.settings.social_instagram_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Instagram">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm10 2H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3z"/>
                    <path d="M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm5.5-1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.social_facebook_link != blank -%}
              <li>
                <a href="{{ section.settings.social_facebook_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Facebook">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.social_twitter_link != blank -%}
              <li>
                <a href="{{ section.settings.social_twitter_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Twitter">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.05c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.52 8.52 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.social_tiktok_link != blank -%}
              <li>
                <a href="{{ section.settings.social_tiktok_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="TikTok">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93v7.2c0 1.96-.68 3.89-1.91 5.37-1.22 1.49-2.91 2.5-4.8 2.93-1.89.43-3.91.24-5.69-.53-1.78-.77-3.23-2.19-4.04-3.95-.81-1.76-.94-3.79-.37-5.65.57-1.86 1.75-3.46 3.32-4.52 1.57-1.06 3.45-1.5 5.35-1.24.49.07.97.18 1.45.34v4.13c-.34-.14-.7-.25-1.06-.33-.61-.13-1.24-.1-1.83.1-.59.2-1.12.56-1.54 1.02-.42.46-.71 1.02-.82 1.63-.11.61-.03 1.24.23 1.79.26.55.67 1.01 1.18 1.32.51.31 1.11.45 1.71.42.6-.03 1.18-.23 1.68-.58.5-.35.89-.83 1.12-1.39.23-.56.3-1.18.19-1.78V.02h-1z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="footer__copyright">
        &copy; {{ 'now' | date: "%Y" }} <a href="{{ routes.root_url }}" class="footer__copyright-link">{{ shop.name }}</a>. All rights reserved.
      </div>

      {%- if section.settings.payment_enable -%}
        <div class="footer__payment">
          <span class="visually-hidden">Supported payment methods</span>
          <ul class="footer__payment-methods" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="footer__payment-icon">
                {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Social Media Icons"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "Show social media icons"
    },
    {
      "type": "url",
      "id": "social_instagram_link",
      "label": "Instagram link"
    },
    {
      "type": "url",
      "id": "social_facebook_link",
      "label": "Facebook link"
    },
    {
      "type": "url",
      "id": "social_twitter_link",
      "label": "Twitter link"
    },
    {
      "type": "url",
      "id": "social_tiktok_link",
      "label": "TikTok link"
    },
    {
      "type": "header",
      "content": "Payment Methods"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "Show payment icons"
    }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Store Info",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Store logo"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 50,
          "max": 200,
          "step": 10,
          "default": 100,
          "unit": "px",
          "label": "Logo width"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "About Us",
          "label": "Heading",
          "info": "Used if no logo is selected"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Share store details, promotions, or brand content with your customers.</p>",
          "label": "Text"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Quick links",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Subscribe to our emails",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>A short sentence describing what someone will receive by subscribing</p>",
          "label": "Text"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "info"
      },
      {
        "type": "link_list",
        "settings": {
          "heading": "Shop"
        }
      },
      {
        "type": "link_list",
        "settings": {
          "heading": "Support"
        }
      },
      {
        "type": "newsletter"
      }
    ]
  }
}
{% endschema %}