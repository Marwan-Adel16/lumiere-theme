{% comment %} sections/featured-collection.liquid {% endcomment %}

<style>
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .featured-collection {
    background-color: rgb(var(--color-base-background));
  }

  .featured-collection__header {
    text-align: center;
    margin-bottom: 4rem;
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
  }

  .featured-collection__heading {
    margin: 0 0 1.5rem;
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .featured-collection__subheading {
    font-size: 1.6rem;
    color: rgba(var(--color-base-text), 0.8);
    line-height: 1.6;
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .featured-collection__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  @media screen and (min-width: 990px) {
    .featured-collection__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  .featured-collection__item {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .featured-collection__footer {
    margin-top: 5rem;
    text-align: center;
  }

  .featured-collection__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.4rem 3.6rem;
    background-color: rgb(var(--color-base-text));
    color: rgb(var(--color-base-background));
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border: 0.1rem solid rgb(var(--color-base-text));
    border-radius: 0.2rem;
    transition: all 0.3s ease;
    min-width: 20rem;
  }

  .featured-collection__btn:hover {
    background-color: transparent;
    color: rgb(var(--color-base-text));
  }

  .featured-collection__btn:focus-visible {
    outline: 0.2rem solid rgb(var(--color-base-text));
    outline-offset: 0.3rem;
  }

  /* Placeholder Styles */
  .product-placeholder {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .product-placeholder__media {
    aspect-ratio: 3 / 4;
    background-color: rgba(var(--color-base-text), 0.03);
    border-radius: 0.4rem;
    margin-bottom: 1.5rem;
    overflow: hidden;
  }

  .product-placeholder__media svg {
    width: 100%;
    height: 100%;
    fill: rgba(var(--color-base-text), 0.2);
  }

  .product-placeholder__info {
    display: flex;
    flex-direction: column;
  }

  .product-placeholder__title {
    font-size: 1.5rem;
    font-weight: 500;
    margin: 0 0 0.8rem;
    color: rgb(var(--color-base-heading));
  }

  .product-placeholder__price {
    font-size: 1.4rem;
    font-weight: 600;
    color: rgb(var(--color-base-text));
  }
</style>

<section class="featured-collection section-{{ section.id }}-padding" aria-labelledby="SectionHeading-{{ section.id }}">
  <div class="page-width">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="featured-collection__header">
        {%- if section.settings.heading != blank -%}
          <h2 id="SectionHeading-{{ section.id }}" class="featured-collection__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="featured-collection__subheading">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign collection = section.settings.collection -%}

    <ul class="featured-collection__grid" role="list">
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        <li class="featured-collection__item">
          {% render 'product-card'
            ,
 product: product
            ,
 show_vendor: section.settings.show_vendor
            ,
 show_rating: section.settings.show_rating
          %}
        </li>
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          {%- assign placeholder_index = i | modulo: 6 | plus: 1 -%}
          <li class="featured-collection__item">
            <div class="product-placeholder">
              <div class="product-placeholder__media">
                {{ 'product-' | append: placeholder_index | placeholder_svg_tag }}
              </div>
              <div class="product-placeholder__info">
                {%- if section.settings.show_vendor -%}
                  <span style="font-size: 1.1rem; text-transform: uppercase; opacity: 0.6; margin-bottom: 0.5rem;">Vendor</span>
                {%- endif -%}
                <h3 class="product-placeholder__title">Example Product Title</h3>
                <span class="product-placeholder__price">$99.99</span>
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_view_all and collection.all_products_count > section.settings.products_to_show -%}
      <div class="featured-collection__footer">
        <a
          href="{{ collection.url }}"
          class="featured-collection__btn"
          aria-label="View all products in the {{ collection.title | escape }} collection">
          View All
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
  {
    "name": "Featured Collection",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "default": "Featured Collection",
        "label": "Heading"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Subheading",
        "default": "<p>Highlight your best selling products or newest arrivals.</p>"
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      },
      {
        "type": "range",
        "id": "products_to_show",
        "min": 2,
        "max": 24,
        "step": 1,
        "default": 4,
        "label": "Maximum products to show"
      }, {
        "type": "range",
        "id": "columns_desktop",
        "min": 2,
        "max": 5,
        "step": 1,
        "default": 4,
        "label": "Number of columns on desktop"
      }, {
        "type": "checkbox",
        "id": "show_view_all",
        "default": true,
        "label": "Enable 'View all' button if collection has more products than shown"
      }, {
        "type": "header",
        "content": "Product Card settings"
      }, {
        "type": "checkbox",
        "id": "show_vendor",
        "default": false,
        "label": "Show vendor"
      }, {
        "type": "checkbox",
        "id": "show_rating",
        "default": false,
        "label": "Show product rating",
        "info": "To display a rating, add a product rating app."
      }, {
        "type": "header",
        "content": "Section Padding"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Top padding",
        "default": 64
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Bottom padding",
        "default": 64
      }
    ],
    "presets": [
      {
        "name": "Featured Collection",
        "category": "Collection"
      }
    ]
  }
{% endschema %}