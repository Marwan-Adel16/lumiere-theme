{%- comment -%} 
    Section: main-product.liquid
    Theme: Lumiere Theme
    Description: Main product page section that orchestrates the product gallery and information layout. 
{%- endcomment -%}

<section
  id="ProductSection-{{ section.id }}"
  class="section section-main-product color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="main-product"
  data-product-handle="{{ product.handle }}"
  data-product-url="{{ product.url }}"
  data-product-id="{{ product.id }}"
  data-gallery-position="{{ section.settings.gallery_position }}"
  data-sticky-enabled="{{ section.settings.enable_sticky_info }}"
  data-animation-enabled="{{ section.settings.enable_animation }}"
  aria-label="{{ product.title | escape }}">

  <div class="container container--{{ section.settings.container_width }}">

    <div class="product-layout product-layout--gallery-{{ section.settings.gallery_position }} product-layout--gap-{{ section.settings.desktop_gap }} {% if section.settings.enable_animation %}product-layout--animated{% endif %}" data-product-layout>

      {%- comment -%} Product Gallery Column {%- endcomment -%}
      <div class="product-layout__column product-layout__column--gallery" data-product-gallery-container>
        {% render 'product-gallery'
          , product: product %}
      </div>

      {%- comment -%} Product Information Column {%- endcomment -%}
      <div class="product-layout__column product-layout__column--info {% if section.settings.enable_sticky_info %}product-layout__column--sticky{% endif %}" data-product-info-container>
        {% render 'product-info'
          , product: product
          , section_id: section.id %}
      </div>

    </div>

  </div>

</section>

{% schema %}
  {
    "name": "Main product",
    "tag": "section",
    "class": "section-main-product",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "container_width",
        "label": "Container width",
        "options": [
          {
            "value": "standard",
            "label": "Standard"
          }, {
            "value": "wide",
            "label": "Wide"
          }, {
            "value": "full",
            "label": "Full width"
          }
        ],
        "default": "standard"
      },
      {
        "type": "select",
        "id": "gallery_position",
        "label": "Gallery position",
        "options": [
          {
            "value": "left",
            "label": "Left"
          }, {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left"
      },
      {
        "type": "checkbox",
        "id": "enable_sticky_info",
        "label": "Enable sticky product info",
        "default": true
      }, {
        "type": "select",
        "id": "desktop_gap",
        "label": "Desktop gap",
        "options": [
          {
            "value": "small",
            "label": "Small"
          }, {
            "value": "medium",
            "label": "Medium"
          }, {
            "value": "large",
            "label": "Large"
          }
        ],
        "default": "medium"
      }, {
        "type": "header",
        "content": "Appearance"
      }, {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "background-1"
      }, {
        "type": "checkbox",
        "id": "enable_animation",
        "label": "Enable animations",
        "default": true
      }, {
        "type": "header",
        "content": "Padding"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Top padding",
        "default": 40
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Bottom padding",
        "default": 40
      }, {
        "type": "range",
        "id": "padding_top_mobile",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Top padding (mobile)",
        "default": 24
      }, {
        "type": "range",
        "id": "padding_bottom_mobile",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Bottom padding (mobile)",
        "default": 24
      }, {
        "type": "header",
        "content": "Margin"
      }, {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Top margin",
        "default": 0
      }, {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Bottom margin",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Main product"
      }
    ]
  }
{% endschema %}