{%- comment -%} 
                    Section: main-collection.liquid
                    Theme: Lumiere Theme
                    Description: Main collection page structural template including header, toolbar, product grid, and pagination. 
{%- endcomment -%}

<section
  id="CollectionSection-{{ section.id }}"
  class="section section-main-collection color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="main-collection">

  {%- comment -%} 2. Responsive container {%- endcomment -%}
  <div class="container container--{{ section.settings.container_width }}">
    {% paginate collection.products by section.settings.products_per_page %}

      {%- comment -%} 3. Collection header wrapper {%- endcomment -%}
      <header class="collection-header" data-collection-header>

        {%- comment -%} 4. Collection image placeholder {%- endcomment -%}
        {%- if section.settings.show_collection_image and collection.image != blank -%}
          <div class="collection-header__image-wrapper" data-collection-image>
            {{ collection.image | image_url: width: 1200 | image_tag:
 class: 'collection-header__image',
 loading: 'eager',
 sizes: '100vw',
 widths: '400, 600, 800, 1000, 1200, 1600',
 alt: collection.image.alt | default: collection.title
            }}
          </div>
        {%- endif -%}

        <div class="collection-header__content">
          {%- comment -%} 5. Collection title {%- endcomment -%}
          <h1 class="collection-header__title">
            <span class="visually-hidden">{{ 'collections.general.collection_label' | t | default: 'Collection' }}:
            </span>
            {{ collection.title | escape }}
          </h1>

          {%- comment -%} 6. Collection description {%- endcomment -%}
          {%- if section.settings.show_collection_description and collection.description != blank -%}
            <div class="collection-header__description rte" data-collection-description>
              {{ collection.description }}
            </div>
          {%- endif -%}
        </div>
      </header>

      {%- comment -%} 7. Toolbar wrapper {%- endcomment -%}
      <div
        class="collection-toolbar"
        id="CollectionToolbar"
        data-collection-toolbar>

        <div class="collection-toolbar__left">

          {% if section.settings.enable_filtering %}
            <button
              type="button"
              class="collection-toolbar__filter-button"
              data-open-filters>

              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none">
                <path
                  d="M4 6H20M7 12H17M10 18H14"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round" />
              </svg>

              <span>Filter</span>
            </button>
          {% endif %}

          <div class="collection-toolbar__count">
            {{ collection.products_count }}
            {{ 'collections.general.products' | t | default: 'Products' }}
          </div>

        </div>

        <div class="collection-toolbar__right">

          {% if section.settings.enable_sorting %}

            <label class="visually-hidden" for="SortBy">
              Sort
            </label>

            <select
              id="SortBy"
              class="collection-toolbar__sort-select"
              data-sort-select>

              {% for option in collection.sort_options %}
                <option
                  value="{{ option.value }}"
                  {% if option.value == collection.sort_by %}
                  selected
                  {% endif %}>
                  {{ option.name }}
                </option>
              {% endfor %}

            </select>

          {% endif %}

          <div class="collection-toolbar__view-switch" data-view-switch>

            <button
              class="is-active"
              data-grid-view
              aria-label="Grid view">

              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor">
                <rect
                  x="3"
                  y="3"
                  width="8"
                  height="8" />
                <rect
                  x="13"
                  y="3"
                  width="8"
                  height="8" />
                <rect
                  x="3"
                  y="13"
                  width="8"
                  height="8" />
                <rect
                  x="13"
                  y="13"
                  width="8"
                  height="8" />
              </svg>

            </button>

            <button data-list-view aria-label="List view">

              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor">
                <rect
                  x="4"
                  y="5"
                  width="16"
                  height="2" />
                <rect
                  x="4"
                  y="11"
                  width="16"
                  height="2" />
                <rect
                  x="4"
                  y="17"
                  width="16"
                  height="2" />
              </svg>

            </button>

          </div>

        </div>

      </div>

      <div
        class="collection-content"
        id="CollectionContent"
        data-collection-content>

        {%- comment -%} 8. Product grid wrapper {%- endcomment -%}
        {%- if paginate.items.size > 0 -%}
          <div class="collection-grid grid grid--{{ section.settings.desktop_columns }}-col-desktop grid--{{ section.settings.mobile_columns }}-col-mobile" data-product-grid>

            {% for product in paginate.items %}
              {% render 'product-card'
                , product: product %}
            {%- endfor -%}

          </div>
        {%- else -%}
          <div class="collection-empty" data-collection-empty>
            <div class="collection-empty__content">
              <h2 class="collection-empty__title">
                {{ 'collections.general.no_matches' | t | default: 'No products found' }}
              </h2>

              <p class="collection-empty__text">
                {{ 'collections.general.use_fewer_filters' | t | default: 'Try checking your spelling or using different filters.' }}
              </p>

              <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
                {{ 'general.continue_shopping' | t | default: 'Continue shopping' }}
              </a>
            </div>
          </div>
        {%- endif -%}


        {%- comment -%} 10. Pagination wrapper {%- endcomment -%}
        {%- if paginate.pages > 1 -%}
          {% render 'pagination'
            , paginate: paginate %}
        {%- endif -%}

      </div>
    {% endpaginate %}

  </div>
</section>

{%- comment -%} 11. Complete Shopify schema {%- endcomment -%}
{% schema %}
  {
    "name": "t:sections.main-collection.name",
    "tag": "section",
    "class": "section-main-collection",
    "settings": [
      {
        "type": "header",
        "content": "t:sections.main-collection.settings.header_layout.content"
      },
      {
        "type": "select",
        "id": "container_width",
        "label": "t:sections.main-collection.settings.container_width.label",
        "options": [
          {
            "value": "standard",
            "label": "t:sections.main-collection.settings.container_width.options.standard"
          }, {
            "value": "wide",
            "label": "t:sections.main-collection.settings.container_width.options.wide"
          }, {
            "value": "full",
            "label": "t:sections.main-collection.settings.container_width.options.full"
          }
        ],
        "default": "standard"
      },
      {
        "type": "header",
        "content": "t:sections.main-collection.settings.header_appearance.content"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.main-collection.settings.color_scheme.label",
        "default": "background-1"
      }, {
        "type": "checkbox",
        "id": "show_collection_image",
        "label": "t:sections.main-collection.settings.show_collection_image.label",
        "default": true
      }, {
        "type": "checkbox",
        "id": "show_collection_description",
        "label": "t:sections.main-collection.settings.show_collection_description.label",
        "default": true
      }, {
        "type": "header",
        "content": "t:sections.main-collection.settings.header_grid.content"
      }, {
        "type": "range",
        "id": "products_per_page",
        "min": 8,
        "max": 48,
        "step": 4,
        "label": "t:sections.main-collection.settings.products_per_page.label",
        "default": 16
      }, {
        "type": "range",
        "id": "desktop_columns",
        "min": 2,
        "max": 5,
        "step": 1,
        "label": "t:sections.main-collection.settings.desktop_columns.label",
        "default": 4
      }, {
        "type": "select",
        "id": "mobile_columns",
        "label": "t:sections.main-collection.settings.mobile_columns.label",
        "options": [
          {
            "value": "1",
            "label": "1"
          }, {
            "value": "2",
            "label": "2"
          }
        ],
        "default": "2"
      }, {
        "type": "header",
        "content": "t:sections.main-collection.settings.header_filtering_sorting.content"
      }, {
        "type": "checkbox",
        "id": "enable_filtering",
        "label": "t:sections.main-collection.settings.enable_filtering.label",
        "info": "t:sections.main-collection.settings.enable_filtering.info",
        "default": true
      }, {
        "type": "checkbox",
        "id": "enable_sorting",
        "label": "t:sections.main-collection.settings.enable_sorting.label",
        "default": true
      }, {
        "type": "header",
        "content": "t:sections.main-collection.settings.header_padding.content"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:sections.main-collection.settings.padding_top.label",
        "default": 40
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:sections.main-collection.settings.padding_bottom.label",
        "default": 40
      }, {
        "type": "header",
        "content": "t:sections.main-collection.settings.header_margin.content"
      }, {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:sections.main-collection.settings.margin_top.label",
        "default": 0
      }, {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:sections.main-collection.settings.margin_bottom.label",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "t:sections.main-collection.presets.name"
      }
    ]
  }
{% endschema %}