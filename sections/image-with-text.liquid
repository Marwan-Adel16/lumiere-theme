{% comment %} sections/image-with-text.liquid {% endcomment %}

<style>
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .image-with-text {
    background-color: rgb(var(--color-base-background));
    overflow: hidden;
  }

  .image-with-text__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .image-with-text__grid {
      grid-template-columns: 1fr 1fr;
      gap: 8rem;
    }

    .image-with-text__grid--text-first .image-with-text__media-item {
      grid-column: 2;
      grid-row: 1;
    }

    .image-with-text__grid--text-first .image-with-text__content-item {
      grid-column: 1;
      grid-row: 1;
    }
  }

  /* Media Item */
  .image-with-text__media-item {
    width: 100%;
  }

  .image-with-text__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: rgba(var(--color-base-text), 0.03);
    border-radius: 0.2rem;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .image-with-text__media {
      aspect-ratio: 3 / 4;
    }
  }

  .image-with-text__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    opacity: 0;
    transform: scale(1.05);
    transition: opacity 0.8s ease
    , transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .is-visible .image-with-text__image {
    opacity: 1;
    transform: scale(1);
  }

  .image-with-text__placeholder {
    width: 100%;
    height: 100%;
    fill: rgba(var(--color-base-text), 0.2);
  }

  /* Content Item */
  .image-with-text__content-item {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .image-with-text__content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 50rem;
  }

  /* Alignments */
  .image-with-text__content--left {
    text-align: left;
    align-items: flex-start;
    margin-right: auto;
  }

  .image-with-text__content--center {
    text-align: center;
    align-items: center;
    margin-left: auto;
    margin-right: auto;
  }

  .image-with-text__content--right {
    text-align: right;
    align-items: flex-end;
    margin-left: auto;
  }

  /* Blocks */
  .image-with-text__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    line-height: 1.1;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: rgb(var(--color-base-heading));
  }

  .image-with-text__text {
    margin: 0;
    font-size: 1.6rem;
    line-height: 1.6;
    color: rgba(var(--color-base-text), 0.8);
  }

  .image-with-text__text p {
    margin: 0;
  }

  .image-with-text__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .image-with-text__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.4rem 3.2rem;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 0.2rem;
    transition: all 0.3s ease;
    min-width: 16rem;
  }

  .image-with-text__btn--primary {
    background-color: rgb(var(--color-base-text));
    color: rgb(var(--color-base-background));
    border: 0.1rem solid rgb(var(--color-base-text));
  }

  .image-with-text__btn--primary:hover {
    background-color: transparent;
    color: rgb(var(--color-base-text));
  }

  .image-with-text__btn--secondary {
    background-color: transparent;
    color: rgb(var(--color-base-text));
    border: 0.1rem solid rgb(var(--color-base-text));
  }

  .image-with-text__btn--secondary:hover {
    background-color: rgb(var(--color-base-text));
    color: rgb(var(--color-base-background));
  }

  /* Animations */
  .iwt-animate {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1)
    , transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .is-visible .iwt-animate {
    opacity: 1;
    transform: translateY(0);
  }

  .is-visible .iwt-animate:nth-child(1) {
    transition-delay: 0.1s;
  }
  .is-visible .iwt-animate:nth-child(2) {
    transition-delay: 0.2s;
  }
  .is-visible .iwt-animate:nth-child(3) {
    transition-delay: 0.3s;
  }
  .is-visible .iwt-animate:nth-child(4) {
    transition-delay: 0.4s;
  }
</style>

<image-with-text-section class="image-with-text section-{{ section.id }}-padding" style="display: block;">
  <div class="page-width">
    <div class="image-with-text__grid {% if section.settings.layout == 'text_first' %} image-with-text__grid--text-first{% endif %}">

      <div class="image-with-text__media-item">
        <div class="image-with-text__media">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1500 | image_tag:
 class: 'image-with-text__image',
 loading: 'lazy',
 widths: '375, 550, 750, 1100, 1500',
 alt: section.settings.image.alt | default: section.settings.heading | escape
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'image-with-text__placeholder' }}
          {%- endif -%}
        </div>
      </div>

      <div class="image-with-text__content-item">
        <div class="image-with-text__content image-with-text__content--{{ section.settings.text_alignment }}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                <h2 class="image-with-text__heading iwt-animate" {{ block.shopify_attributes }}>
                  {{ block.settings.heading | escape }}
                </h2>

              {%- when 'text' -%}
                <div class="image-with-text__text iwt-animate" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>

              {%- when 'buttons' -%}
                {%- if block.settings.button_1_label != blank or block.settings.button_2_label != blank -%}
                  <div class="image-with-text__buttons iwt-animate" {{ block.shopify_attributes }}>
                    {%- if block.settings.button_1_label != blank -%}
                      <a
                        {% if block.settings.button_1_link == blank %}
                        role="link"
                        aria-disabled="true"
                        {% else %}
                        href="{{ block.settings.button_1_link }}"
                        {% endif %}
                        class="image-with-text__btn image-with-text__btn--primary">
                        {{ block.settings.button_1_label | escape }}
                      </a>
                    {%- endif -%}

                    {%- if block.settings.button_2_label != blank -%}
                      <a
                        {% if block.settings.button_2_link == blank %}
                        role="link"
                        aria-disabled="true"
                        {% else %}
                        href="{{ block.settings.button_2_link }}"
                        {% endif %}
                        class="image-with-text__btn image-with-text__btn--secondary">
                        {{ block.settings.button_2_label | escape }}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</image-with-text-section>

<script>
  if (!customElements.get('image-with-text-section')) {
    class ImageWithText extends HTMLElement {
      constructor() {
        super();
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              requestAnimationFrame(() => {
                entry.target.classList.add('is-visible');
              });
              this.observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });
      }
  
      connectedCallback() {
        this.observer.observe(this);
      }
  
      disconnectedCallback() {
        this.observer.disconnect();
      }
    }
    customElements.define('image-with-text-section', ImageWithText);
  }
</script>

{% schema %}
  {
    "name": "Image with text",
    "class": "section",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "select",
        "id": "layout",
        "options": [
          {
            "value": "image_first",
            "label": "Image first"
          }, {
            "value": "text_first",
            "label": "Image second"
          }
        ],
        "default": "image_first",
        "label": "Desktop image placement",
        "info": "Image first is the default mobile layout."
      },
      {
        "type": "select",
        "id": "text_alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          }, {
            "value": "center",
            "label": "Center"
          }, {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left",
        "label": "Desktop content alignment"
      },
      {
        "type": "header",
        "content": "Section Padding"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Top padding",
        "default": 64
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Bottom padding",
        "default": 64
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "default": "Image with text",
            "label": "Heading"
          }
        ]
      }, {
        "type": "text",
        "name": "Text",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
            "label": "Description"
          }
        ]
      }, {
        "type": "buttons",
        "name": "Buttons",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "button_1_label",
            "default": "Shop Now",
            "label": "Primary button label",
            "info": "Leave the label blank to hide the button."
          }, {
            "type": "url",
            "id": "button_1_link",
            "label": "Primary button link"
          }, {
            "type": "text",
            "id": "button_2_label",
            "label": "Secondary button label",
            "info": "Leave the label blank to hide the button."
          }, {
            "type": "url",
            "id": "button_2_link",
            "label": "Secondary button link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Image with text",
        "blocks": [
          {
            "type": "heading"
          }, {
            "type": "text"
          }, {
            "type": "buttons"
          }
        ]
      }
    ]
  }
{% endschema %}