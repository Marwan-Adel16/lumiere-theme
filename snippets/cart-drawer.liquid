{% comment %} 
  Snippet: cart-drawer.liquid 
{% endcomment %}

<div
  id="CartDrawer"
  class="cart-drawer"
  aria-hidden="true">

  <div class="cart-drawer__overlay" data-cart-close></div>

  <aside
    class="cart-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-label="Shopping Cart">

    <header class="cart-drawer__header">

      <h2 class="cart-drawer__title">
        {{ 'sections.cart.title' | t | default: 'Shopping Cart' }}
      </h2>

      <button
        type="button"
        class="cart-drawer__close"
        data-cart-close
        aria-label="Close">

        ✕

      </button>

    </header>

    <div class="cart-drawer__body" data-cart-drawer-content>

      {% if cart.item_count > 0 %}

        {% render 'cart-items'
          , cart: cart %}

      {% else %}

        <div class="cart-drawer__empty">

          <p>
            {{ 'sections.cart.empty' | t | default: 'Your cart is empty' }}
          </p>

          <a href="{{ routes.all_products_collection_url }}" class="button button--primary">

            Continue Shopping

          </a>

        </div>

      {% endif %}

    </div>

    {% if cart.item_count > 0 %}

      <footer class="cart-drawer__footer">

        {% render 'cart-summary'
          , cart: cart %}

      </footer>

    {% endif %}

  </aside>

</div>