{% comment %} 
  ------------------------------------------------------------------------------
  Snippet: filter-drawer.liquid
  Description:
  Reusable Collection Filter Drawer
  Theme: Lumiere
  ------------------------------------------------------------------------------ 
{% endcomment %}

<filter-drawer class="filter-drawer" data-filter-drawer>

  <div class="filter-drawer__overlay" data-filter-overlay></div>

  <aside
    class="filter-drawer__panel"
    aria-label="Collection filters"
    tabindex="-1">

    <header class="filter-drawer__header">

      <h2 class="filter-drawer__title">
        Filters
      </h2>

      <button
        type="button"
        class="filter-drawer__close"
        aria-label="Close filters"
        data-filter-close>
        ✕
      </button>

    </header>

    <div class="filter-drawer__body">

      {% if collection.filters != empty %}

        {% for filter in collection.filters %}

          <details class="filter-group" open>

            <summary class="filter-group__title">
              {{ filter.label }}
            </summary>

            <div class="filter-group__content">

              {% case filter.type %}

                {% when 'list' %}

                  <ul class="filter-list">

                    {% for value in filter.values %}

                      <li class="filter-list__item">

                        <label class="filter-checkbox">

                          <input
                            type="checkbox"
                            value="{{ value.value | escape }}"
                            {% if value.active %}
                            checked
                            {% endif %}>

                          <span class="filter-checkbox__label">
                            {{ value.label }}
                          </span>

                          <span class="filter-checkbox__count">
                            {{ value.count }}
                          </span>

                        </label>

                      </li>

                    {% endfor %}

                  </ul>

                {% when 'price_range' %}

                  <div class="filter-price">

                    <div class="filter-price__field">

                      <label>
                        From
                      </label>

                      <input
                        type="number"
                        value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                        placeholder="0">

                    </div>

                    <div class="filter-price__field">

                      <label>
                        To
                      </label>

                      <input
                        type="number"
                        value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                        placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}">

                    </div>

                  </div>

              {% endcase %}

            </div>

          </details>

        {% endfor %}

      {% else %}

        <div class="filter-empty">

          <p>
            No filters available.
          </p>

        </div>

      {% endif %}

    </div>

    <footer class="filter-drawer__footer">

      <button
        class="button button--secondary"
        type="reset"
        data-filter-clear>
        Clear all
      </button>

      <button
        class="button button--primary"
        type="submit"
        data-filter-apply>
        Apply
      </button>

    </footer>

  </aside>

</filter-drawer>