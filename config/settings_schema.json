[
  {
    "name": "theme_info",
    "theme_name": "Lumière",
    "theme_author": "Senior Shopify Engineer",
    "theme_version": "1.0.0",
    "theme_support_url": "https://shopify.com",
    "theme_documentation_url": "https://shopify.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_base_text",
        "label": "Text",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "color_base_heading",
        "label": "Heading",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_base_background",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_base_accent",
        "label": "Accent",
        "default": "#0056b3"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "helvetica_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "helvetica_n4"
      },
      {
        "type": "range",
        "id": "type_body_scale",
        "min": 100,
        "max": 150,
        "step": 5,
        "unit": "%",
        "label": "Body text scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 100,
        "unit": "px",
        "label": "Page width",
        "default": 1200
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  }
]
